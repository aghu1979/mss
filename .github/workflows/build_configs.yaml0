name: Build and Validate Mihomo Configs

# 触发条件: 监听到 main 分支的 src 或 scripts 目录变动，或者网页端手动触发
on:
  push:
    branches:
      - main
    paths:
      - 'src/**'
      - 'scripts/**'
  workflow_dispatch:

jobs:
  build-validate-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: pip install pyyaml

      - name: Build and Validate Configs
        # 你的 Python 脚本现在包揽了：清洗文本 -> 深度合并 -> 动态拉取 Alpha 内核 -> 执行 -t 强校验
        # 如果脚本中抛出 Exception 或校验失败，此步骤会自动阻断后续的推送
        run: python scripts/build_configs.py

      - name: Deploy to Release Branch
        # 仅当 Python 脚本 100% 成功执行完毕后，才会将产物推送到发布分支
        if: success()
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_branch: release
          publish_dir: ./configs
          destination_dir: configs 
          keep_files: true         
          commit_message: "Auto-build and validated configs by Mihomo Alpha"
